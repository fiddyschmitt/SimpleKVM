<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- One assembly for every OS: the Windows and macOS backends both compile in, and
         PlatformServices picks the right one at runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.4.1</Version>
    <ApplicationIcon>iconfinder_Communication_pc_computer_sharing_6588768_white_bg.ico</ApplicationIcon>
    <!-- Trimming turns built-in COM interop off by default; the Windows USB watcher (WMI via
         System.Management) and the startup shortcut (IShellLink) both need it -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="iconfinder_Communication_pc_computer_sharing_6588768_white_bg.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Management" Version="10.0.7" />
    <!-- Source-generated Win32 bindings for the functions listed in Platform\win\NativeMethods.txt -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <AdditionalFiles Include="Platform\win\NativeMethods.txt" />
  </ItemGroup>

  <!-- Trimming: assemblies the trimmer must leave whole because their use is invisible to
       static analysis (verified by launching the trimmed app):
       - Avalonia.Controls.DataGrid: its theme is loaded by avares:// URI
       - System.Management: WMI is COM/reflection-driven and loses helper types -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia.Controls.DataGrid" />
    <TrimmerRootAssembly Include="System.Management" />
  </ItemGroup>

  <!-- Release size (Windows publishes): drop native files the published app never uses.
       - av_libglesv2.dll: ANGLE (OpenGL ES) - the app renders in software mode, see Program.BuildAvaloniaApp
       - mscordaccore*, mscordbi, DiaSymReader, createdump: the runtime's debugger/crash-dump
         support, which only serves attached debuggers -->
  <Target Name="RemoveUnusedNatives" AfterTargets="ComputeResolvedFilesToPublishList" Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'av_libglesv2.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('mscordaccore'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'mscordbi'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader.Native'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'createdump.exe'" />
    </ItemGroup>
  </Target>

</Project>
